{
  "name": "@aisketch/client-ui-sketch",
  "version": "0.4.0+upstream.0.3.0",
  "description": "AISketch browser card: renders the sketch_function tool view as a live Canvas plot",
  "type": "module",
  "license": "MIT",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "node build-client.mjs"
  },
  "dependencies": {
    "@aisketch/sketch-core": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-tool": "0.2.2-rc.3",
    "@types/react": "~18.3.1",
    "esbuild": "^0.25.12",
    "react": "^18.2.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "@types/react-dom": "~18.3.1",
    "react-dom": "^18.2.0"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-tool"
      ],
      "platform": "web"
    }
  },
  "author": "llql1211",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/llql1211/DSH-Sketch.git"
  },
  "homepage": "https://github.com/llql1211/DSH-Sketch#readme",
  "bugs": {
    "url": "https://github.com/llql1211/DSH-Sketch/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "function-plot",
    "canvas",
    "visualization"
  ]
}
