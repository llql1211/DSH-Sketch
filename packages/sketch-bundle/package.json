{
  "name": "@llql1211/dsh-sketch",
  "version": "0.4.0+upstream.0.3.0",
  "description": "DSH-Sketch bundle: mounts the sketch_function tool, its browser card, and the generic show_card card channel into a dsh profile",
  "type": "module",
  "license": "MIT",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@aisketch/sketch-tool": "workspace:*",
    "@aisketch/client-ui-sketch": "workspace:*",
    "@aisketch/cards-tool": "workspace:*",
    "@aisketch/client-ui-cards": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "author": "llql1211",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/llql1211/DSH-Sketch.git"
  },
  "homepage": "https://github.com/llql1211/DSH-Sketch#readme",
  "bugs": {
    "url": "https://github.com/llql1211/DSH-Sketch/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "show-card",
    "function-plot",
    "table",
    "flowchart",
    "draw",
    "figure",
    "visualization",
    "bundle"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.3 <0.3.0"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "locale/*.json"
  ]
}
